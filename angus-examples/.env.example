# Angus Mail Examples 配置
# 复制此文件为 .env 并填写实际配置
# cp .env.example .env

# SMTP 服务器配置
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# 邮件地址
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=Your Name
MAIL_TO=recipient@example.com

# 可选：CC / BCC（多个地址用逗号分隔）
# MAIL_CC=cc1@example.com,cc2@example.com
# MAIL_BCC=bcc@example.com

# 可选：OAuth2 Token（XOAUTH2 认证场景）
# OAUTH2_TOKEN=ya29.xxxxxxxx

# 可选：附件测试文件路径
ATTACHMENT_PATH=src/main/resources/test.txt

# 可选：内嵌图片路径（场景 4/5）
IMAGE_PATH=src/main/resources/logo.jpg

# 调试模式（true/false）
DEBUG=false
