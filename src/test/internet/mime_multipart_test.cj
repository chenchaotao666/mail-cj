package mail.test.internet

import mail.internet.*
import mail.activation.*
import std.io.*
import std.collection.*

// ─── helpers ─────────────────────────────────────────────────────────────────

class PartByteBuffer <: OutputStream {
    var _data: ArrayList<Byte> = ArrayList<Byte>()
    public override func write(d: Array<Byte>): Unit { for (b in d) { _data.add(b) } }
    public override func flush(): Unit {}
    public func toString(): String {
        try { String.fromUtf8(_data.toArray()) } catch (_: Exception) { "" }
    }
}

func textPart(content: String): MimeBodyPart {
    let p = MimeBodyPart()
    p.setText(content)
    p
}

// ─── MimeMultipart structure ──────────────────────────────────────────────────

@Test
public class MimeMultipartStructureTest {

    @TestCase
    func defaultSubtypeIsMixed(): Unit {
        @Expect(MimeMultipart().getSubType(), MULTIPART_MIXED)
    }

    @TestCase
    func specifiedSubtypeIsStored(): Unit {
        @Expect(MimeMultipart("alternative").getSubType(), MULTIPART_ALTERNATIVE)
        @Expect(MimeMultipart("related").getSubType(), MULTIPART_RELATED)
    }

    @TestCase
    func addAndCountParts(): Unit {
        let mp = MimeMultipart()
        mp.addBodyPart(textPart("A"))
        mp.addBodyPart(textPart("B"))
        @Expect(mp.getCount(), 2)
    }

    @TestCase
    func addAtIndexInsertsBefore(): Unit {
        let mp = MimeMultipart()
        mp.addBodyPart(textPart("First"))
        mp.addBodyPart(textPart("Second"), 0)
        @Expect(mp.getCount(), 2)
        @Assert(mp.getBodyPart(0).getContent().getOrThrow() == "Second")
        @Assert(mp.getBodyPart(1).getContent().getOrThrow() == "First")
    }

    @TestCase
    func removeByIndexShiftsParts(): Unit {
        let mp = MimeMultipart()
        mp.addBodyPart(textPart("A"))
        mp.addBodyPart(textPart("B"))
        mp.removeBodyPart(0)
        @Expect(mp.getCount(), 1)
        @Assert(mp.getBodyPart(0).getContent().getOrThrow() == "B")
    }

    @TestCase
    func removeByRefRemovesMatchingPart(): Unit {
        let mp = MimeMultipart()
        let p = MimeBodyPart()
        p.setText("remove me")
        p.setContentID("cid001")
        mp.addBodyPart(p)
        mp.removeBodyPart(p)
        @Expect(mp.getCount(), 0)
    }

    @TestCase
    func getBodyPartByIndexReturnsCorrectPart(): Unit {
        let mp = MimeMultipart()
        mp.addBodyPart(textPart("One"))
        mp.addBodyPart(textPart("Two"))
        @Assert(mp.getBodyPart(0).getContent().getOrThrow() == "One")
        @Assert(mp.getBodyPart(1).getContent().getOrThrow() == "Two")
    }

    @TestCase
    func getBodyPartByContentIdFindsWithOrWithoutBrackets(): Unit {
        let mp = MimeMultipart()
        let p = MimeBodyPart()
        p.setText("img")
        p.setContentID("img001")
        mp.addBodyPart(p)
        @Assert(mp.getBodyPart("img001").isSome())
        @Assert(mp.getBodyPart("<img001>").isSome())
        @Assert(mp.getBodyPart("nonexistent").isNone())
    }
}

// ─── boundary ────────────────────────────────────────────────────────────────

@Test
public class MimeMultipartBoundaryTest {

    @TestCase
    func setBoundaryRoundTrips(): Unit {
        let mp = MimeMultipart()
        mp.setBoundary("my-custom-boundary")
        @Expect(mp.getBoundary(), Some("my-custom-boundary"))
    }

    @TestCase
    func autoGeneratedBoundariesAreUnique(): Unit {
        @Assert(MimeMultipart().getBoundary() != MimeMultipart().getBoundary())
    }

    @TestCase
    func setSubType(): Unit {
        let mp = MimeMultipart()
        mp.setSubType("related")
        @Expect(mp.getSubType(), "related")
    }

    @TestCase
    func setPreamble(): Unit {
        let mp = MimeMultipart()
        mp.setPreamble("This is a MIME message.")
        @Expect(mp.getPreamble(), Some("This is a MIME message."))
    }

    @TestCase
    func isCompleteOnlyWhenHasParts(): Unit {
        let mp = MimeMultipart()
        @Assert(!mp.isComplete())
        mp.addBodyPart(MimeBodyPart())
        @Assert(mp.isComplete())
    }
}

// ─── serialization ───────────────────────────────────────────────────────────

@Test
public class MimeMultipartSerializeTest {

    @TestCase
    func writeToContainsBoundaryDelimiters(): Unit {
        let mp = MimeMultipart()
        mp.setBoundary("testboundary")
        mp.addBodyPart(textPart("Content"))
        let buf = PartByteBuffer()
        mp.writeTo(buf)
        let s = buf.toString()
        @Assert(s.contains("--testboundary"))
        @Assert(s.contains("--testboundary--"))
    }

    @TestCase
    func writeToContainsPartContent(): Unit {
        let mp = MimeMultipart()
        mp.addBodyPart(textPart("Hello World"))
        let buf = PartByteBuffer()
        mp.writeTo(buf)
        @Assert(buf.toString().contains("Hello World"))
    }
}

// ─── MimeBodyPart content ─────────────────────────────────────────────────────

@Test
public class MimeBodyPartContentTest {

    @TestCase
    func setTextPlainSetsContentType(): Unit {
        let p = MimeBodyPart()
        p.setText("Hello")
        @Assert(p.getContentType().startsWith("text/plain"))
    }

    @TestCase
    func setTextWithCharsetAndSubtype(): Unit {
        let p = MimeBodyPart()
        p.setText("Hi", "UTF-8", "html")
        @Assert(p.getContentType().startsWith("text/html"))
        @Assert(p.getContentType().contains("UTF-8"))
    }

    @TestCase
    func setHtmlContent(): Unit {
        let p = MimeBodyPart()
        p.setHtmlContent("<b>Bold</b>")
        @Assert(p.getContentType().startsWith("text/html"))
    }

    @TestCase
    func getContentReturnsStoredText(): Unit {
        let p = MimeBodyPart()
        p.setText("Test Content")
        @Expect(p.getContent(), Some("Test Content"))
    }

    @TestCase
    func getSizePositiveWhenHasContent(): Unit {
        let p = MimeBodyPart()
        p.setText("Some data here")
        @Assert(p.getSize() > 0)
    }

    @TestCase
    func isMimeTypeExactMatch(): Unit {
        let p = MimeBodyPart()
        p.setText("Hello")
        @Assert(p.isMimeType("text/plain"))
        @Assert(!p.isMimeType("text/html"))
        @Assert(!p.isMimeType("application/pdf"))
    }

    @TestCase
    func isMimeTypeHtmlPart(): Unit {
        let p = MimeBodyPart()
        p.setHtmlContent("<b>Hi</b>")
        @Assert(p.isMimeType("text/html"))
        @Assert(!p.isMimeType("text/plain"))
    }
}

// ─── MimeBodyPart attributes ──────────────────────────────────────────────────

@Test
public class MimeBodyPartAttributeTest {

    @TestCase
    func setGetFileName(): Unit {
        let p = MimeBodyPart()
        p.setFileName("report.pdf")
        @Expect(p.getFileName(), Some("report.pdf"))
    }

    @TestCase
    func setDispositionInlineAndAttachment(): Unit {
        let p = MimeBodyPart()
        p.setDisposition(PART_INLINE)
        @Expect(p.getDisposition(), Some(PART_INLINE))
        p.setDisposition(PART_ATTACHMENT)
        @Expect(p.getDisposition(), Some(PART_ATTACHMENT))
    }

    @TestCase
    func setContentIdAddsAngularBrackets(): Unit {
        let p = MimeBodyPart()
        p.setContentID("img001")
        @Expect(p.getContentID(), Some("<img001>"))
    }

    @TestCase
    func setContentIdPreservesExistingBrackets(): Unit {
        let p = MimeBodyPart()
        p.setContentID("<img002>")
        @Expect(p.getContentID(), Some("<img002>"))
    }

    @TestCase
    func setGetCustomHeader(): Unit {
        let p = MimeBodyPart()
        p.setHeader("X-Part-Id", "abc123")
        @Expect(p.getHeader("X-Part-Id"), Some("abc123"))
    }

    @TestCase
    func addHeaderAccumulatesValues(): Unit {
        let p = MimeBodyPart()
        p.addHeader("X-Tag", "v1")
        p.addHeader("X-Tag", "v2")
        // getHeader returns first value
        @Expect(p.getHeader("X-Tag"), Some("v1"))
    }
}

// ─── MimeBodyPart DataHandler ─────────────────────────────────────────────────

@Test
public class MimeBodyPartDataHandlerTest {

    @TestCase
    func setDataHandlerFromByteArrayDataSource(): Unit {
        let data = "text data".toArray()
        let ds = ByteArrayDataSource(data, "text/plain")
        let dh = DataHandler(ds)
        let p = MimeBodyPart()
        p.setDataHandler(dh)
        @Assert(p.getContentType().startsWith("text/plain"))
        @Assert(p.getDataHandler().isSome())
    }

    @TestCase
    func createInlineImageBodyPartSetsAttributes(): Unit {
        let data = Array<Byte>(16, repeat: 0u8)
        let ds = ByteArrayDataSource(data, "image/jpeg")
        let part = createInlineImageBodyPartFromDataSource(ds, "logo_cid")
        @Expect(part.getContentID(), Some("<logo_cid>"))
        @Expect(part.getDisposition(), Some(PART_INLINE))
    }
}

// ─── MimeBodyPart serialization ───────────────────────────────────────────────

@Test
public class MimeBodyPartSerializeTest {

    @TestCase
    func writeToOutputContainsHeaderAndBody(): Unit {
        let p = MimeBodyPart()
        p.setText("Body text here")
        let buf = PartByteBuffer()
        p.writeTo(buf)
        let s = buf.toString()
        @Assert(s.contains("Content-Type:"))
        @Assert(s.contains("Body text here"))
    }
}
